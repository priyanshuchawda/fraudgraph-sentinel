# Required: connect scripts to an existing Neo4j AuraDB Free database.
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_aura_database_password
NEO4J_DATABASE=neo4j
IMPORT_BASE_URL=https://example.com/fraudgraph_sentinel

# Optional: Aura management API credentials.
# Not required for normal graph import/query work.
AURA_CLIENT_ID=your_aura_api_client_id
AURA_CLIENT_SECRET=your_aura_api_client_secret
AURA_INSTANCEID=your_aura_instance_id
AURA_INSTANCENAME=your_aura_instance_name
